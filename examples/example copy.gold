	// 				}
	// 			}
	// 		}
	// 	}
	// 	return nil
	// })

	// Track if we've already printed the target class
	hasShownTarget := false

	p.OnEntity(func(e *manta.Entity, op manta.EntityOp) error {
		className := e.GetClassName()

		// If this is the target class and we haven't shown it yet
		if className == targetClass && !hasShownTarget {
			hasShownTarget = true
			log.Printf("\n=== %s (Tick: %d, Op: %v) ===\n", className, p.Tick, op)

			// Get all fields from the entity
			allFields := e.Map()

			if len(allFields) == 0 {
				log.Println("  (No fields)")
			} else {
				// Print each field and its value
				for key, value := range allFields {
					log.Printf("  %s = %v (type: %T)", key, value, value)
				}
			}
			log.Println()
		}

		return nil
	})

	// Start parsing the replay!
	p.Start()

	log.Printf("\nParse Complete!\n")

	if !hasShownTarget {
		log.Printf("Warning: Class '%s' was not found in the replay\n", targetClass)
	}
}
