	// Track player resource entity for detailed stats
	// p.OnEntity(func(e *manta.Entity, op manta.EntityOp) error {
	// 	// CDOTA_PlayerResource contains all player stats
	// 	if e.GetClassName() == "CDOTA_PlayerResource" {
	// 		// Only print periodically to avoid spam
	// 		if p.Tick%500 == 0 {
	// 			log.Printf("\n=== PLAYER STATS at tick %d ===", p.Tick)

	// 			// Loop through all 10 players (0-9)
	// 			for i := 0; i < 10; i++ {
	// 				// Get player name (format changed between game versions)
	// 				var playerName string
